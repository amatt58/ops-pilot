    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
