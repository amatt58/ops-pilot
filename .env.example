# ── Database (Neon Postgres) ─────────────────────────────────────────
# Same two values in Vercel too, applied to ALL environments
# (Production + Preview + Development) — this project uses one shared
# Neon instance (free tier) rather than per-environment databases.

# Unpooled — used by Prisma migrations/seed (see prisma.config.ts)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE_NAME?sslmode=require&channel_binding=require"

# Pooled — used by the running app (see server/db/index.ts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE_NAME?sslmode=require&channel_binding=require"

# ── Auth.js v5 ────────────────────────────────────────────────────────
# This secret is for LOCAL DEV ONLY — do not reuse it in Vercel.
# Production and Preview each need their OWN distinct AUTH_SECRET,
# added by hand in the Vercel dashboard (never pasted from this file).
# Generate a new one anytime with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# AUTH_URL is deliberately NOT set here — Auth.js auto-detects the
# correct URL from each request locally. Do not add it. In Vercel it
# should ONLY exist for Production (never Preview — every preview
# deployment has a different URL, so a fixed value breaks all of them).
